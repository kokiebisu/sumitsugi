{
  "name": "sumitsugi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "shell": "./dev",
    "test:e2e:install": "bunx playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:critical": "playwright test --grep '@critical'",
    "test:e2e:smoke": "playwright test --grep '@smoke'",
    "test:e2e:auth": "playwright test --grep '@auth'",
    "test:e2e:listing": "playwright test --grep '@listing'",
    "test:e2e:properties": "playwright test --grep '@properties'",
    "worktree:create": "bash scripts/create-worktree.sh",
    "worktree:list": "git worktree list",
    "worktree:prune": "git worktree prune",
    "cleanup:branches": "bash scripts/cleanup-branches.sh",
    "cleanup:all": "bun run cleanup:branches && git worktree prune && git stash clear",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:reset": "docker compose down -v && docker compose up -d postgres && sleep 2 && bun run db:migrate",
    "slides": "bun scripts/generate-slides.ts",
    "slides:seller": "bun scripts/generate-slides.ts seller",
    "slides:buyer": "bun scripts/generate-slides.ts buyer",
    "slides:management": "bun scripts/generate-slides.ts management",
    "slides:agency": "bun scripts/generate-slides.ts agency",
    "slides:html": "bunx marp --no-stdin docs/pitch/slides-seller.md --html --output docs/pitch/slides-seller.html && bunx marp --no-stdin docs/pitch/slides-buyer.md --html --output docs/pitch/slides-buyer.html"
  },
  "dependencies": {
    "@auth/core": "^0.41.0",
    "@auth/drizzle-adapter": "^1.11.1",
    "@aws-sdk/client-s3": "^3.984.0",
    "@aws-sdk/s3-request-presigner": "^3.984.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
