#!/bin/bash
# Pre-commit hook: Format, lint, and security check staged files

set -euo pipefail

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|css|md)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# --- Secret detection ---
echo "Checking for hardcoded secrets..."
SECRET_PATTERNS='(AKIA[0-9A-Z]{16}|sk_live_[a-zA-Z0-9]+|ghp_[a-zA-Z0-9]+|-----BEGIN (RSA |EC )?PRIVATE KEY-----|password\s*=\s*["\x27][^"\x27]{8,}|secret\s*=\s*["\x27][^"\x27]{8,})'
SECRETS_FOUND=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -lEn "$SECRET_PATTERNS" 2>/dev/null || true)
if [ -n "$SECRETS_FOUND" ]; then
  echo "🚨 Potential secrets detected in:"
  echo "$SECRETS_FOUND"
  echo "Remove hardcoded secrets and use environment variables instead."
  exit 1
fi

# --- Prevent .env files from being committed ---
ENV_FILES=$(git diff --cached --name-only | grep -E '^\.(env|env\.local|env\.production)' || true)
if [ -n "$ENV_FILES" ]; then
  echo "🚨 Refusing to commit environment files: $ENV_FILES"
  echo "Add them to .gitignore."
  exit 1
fi

# --- Prettier ---
echo "Running Prettier on staged files..."
echo "$STAGED_FILES" | xargs bun prettier --write

# --- ESLint ---
echo "Running ESLint on staged files..."
if echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' > /dev/null; then
  LINT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$')
  echo "$LINT_FILES" | xargs bun eslint

  if [ $? -ne 0 ]; then
    echo "ESLint failed. Fix errors before committing."
    exit 1
  fi
fi

# --- Prevent console.log ---
CONSOLE_LOGS=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -ln 'console\.log' 2>/dev/null || true)
if [ -n "$CONSOLE_LOGS" ]; then
  echo "⚠️  console.log found in:"
  echo "$CONSOLE_LOGS"
  echo "Remove console.log statements before committing."
  exit 1
fi

# Re-stage formatted files
echo "$STAGED_FILES" | xargs git add

exit 0
